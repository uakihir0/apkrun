          }
        }
      }
    },
    "Any local process can then reach Android over ADB at 127.0.0.1:6520. Applies the next time Android starts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any local process can then reach Android over ADB at 127.0.0.1:6520. Applies the next time Android starts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後、ローカルのどのプロセスも 127.0.0.1:6520 の ADB 経由で Android に接続できます。次回の Android 起動時に適用されます。"
          }
        }
      }
    },
    "Any local process can then reach Android over ADB at 127.0.0.1:6520. It applies the next time Android starts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any local process can then reach Android over ADB at 127.0.0.1:6520. It applies the next time Android starts."
