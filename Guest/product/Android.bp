android_app_import {
    name: "ApkRunGuest",
    apk: "prebuilt/ApkRunGuest.apk",
    certificate: "platform",
    privileged: true,
    presigned: false,
    system_ext_specific: true,
}

android_app {
    name: "ApkRunSystemServicesTest",
    manifest: "systemservices-test/AndroidManifest.xml",
    srcs: ["systemservices-test/src/**/*.java"],
    certificate: "platform",
    system_ext_specific: true,
    sdk_version: "current",
}
