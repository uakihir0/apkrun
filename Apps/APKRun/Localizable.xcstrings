        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目を変更できませんでした。システム設定の「ログイン項目」を確認してください。"
          }
        }
      }
    },
    "APKRun couldn't open the menu bar item. Check Login Items in System Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APKRun couldn't open the menu bar item. Check Login Items in System Settings."
