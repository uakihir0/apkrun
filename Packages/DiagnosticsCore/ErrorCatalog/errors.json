      "variants": {
        "notFound": {
          "message": {
            "en": "{file} doesn't exist."
          },
          "remediation": {
            "en": "Check the path."
          },
          "action": "none",
          "doc": {
            "when": "the file doesn't exist",
            "raisedBy": "CLI",
            "ref": "§3.1"
          }
        },
        "permissionDenied": {
          "message": {
            "en": "apkrun isn't allowed to open {file}."
          },
          "remediation": {
            "en": "Check the permissions, or give Terminal access in System Settings → Privacy & Security → Files and Folders."
          },
          "action": "none",
          "doc": {
            "when": "the file or its folder can't be read or written",
            "raisedBy": "CLI",
            "ref": "§3.1"
          }
        },
        "isDirectory": {
          "message": {
            "en": "{file} is a folder."
          },
          "remediation": {
            "en": "Name a file. Unpacked image folders are for apkrun dev image install."
          },
          "action": "none",
          "doc": {
