      "decided": {
        "androidboot.cuttlefish_service_bluetooth_checker": "No rootcanal on VZ; the boot reporter must not wait for Bluetooth, as on Cuttlefish's automotive product (android-image.md §7.6, IR-309).",
        "androidboot.force_normal_boot": "Set by U-Boot on Cuttlefish; direct boot sets it here (android-image.md §6.2).",
