{
  "sourceLanguage": "en",
  "strings": {
    "APKRun Launcher": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APKRun Launcher"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APKRun ランチャー"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Frame Statistics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame Statistics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーム統計"
          }
        }
      }
    },
    "Images over 16 MB or 8192 pixels per side are not sent. The text still went through.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images over 16 MB or 8192 pixels per side are not sent. The text still went through."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "16 MB または一辺 8192 ピクセルを超える画像は送信されません。テキストは送信されました。"
          }
        }
      }
    },
    "Install \\(appName) \\(version) from this Mac app?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install \\(appName) \\(version) from this Mac app?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac アプリから \\(appName) \\(version) をインストールしますか？"
          }
        }
      }
    },
    "Install from This App": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install from This App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリからインストール"
          }
        }
      }
    },
    "Keep in Android": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep in Android"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android で開く"
          }
        }
      }
    },
    "Open in Browser": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Browser"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで開く"
          }
        }
      }
    },
    "Save to Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac に保存"
          }
        }
      }
    },
    "The image is too large to paste.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is too large to paste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が大きすぎてペーストできません。"
          }
        }
      }
    },
    "This Mac app contains the Android app. Install it to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac app contains the Android app. Install it to continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac アプリには Android アプリが含まれています。続けるにはインストールしてください。"
          }
        }
      }
    },
    "\\(appName) could not be installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(appName) could not be installed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(appName) をインストールできませんでした。"
          }
        }
      }
    },
    "\\(packageName) wants to open a link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(packageName) wants to open a link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(packageName) がリンクを開こうとしています。"
          }
        }
      }
    },
    "frameStatistics: \\(error.localizedDescription)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "frameStatistics: \\(error.localizedDescription)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "frameStatistics: \\(error.localizedDescription)"
          }
        }
      }
    },
    "no app session": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no app session"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリセッションなし"
          }
        }
      }
    }
  },
  "version": "1.0"
}
