# apkrun.test=egl (#099). Test variant only; this is not a product service.
#
# The service runs the test binary directly, with no shell and no command-line gate (IR-993). The
# binary has the surfaceflinger_exec label, and the explicit seclabel is the domain that SurfaceFlinger
# runs in, so the rights of SurfaceFlinger (DRM device, logd) apply. The test runs once on
# sys.boot_completed.
service apkrun_egl_test /odm/bin/apkrun_egl_test
    seclabel u:r:surfaceflinger:s0
    user system
    group graphics
    oneshot
    disabled

on property:sys.boot_completed=1
    start apkrun_egl_test
