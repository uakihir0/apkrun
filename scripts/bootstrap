#!/bin/bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
# shellcheck disable=SC1091
source "$script_dir/tool-versions.env"

check_only=0
case "${1:-}" in
    "")
        ;;
    --check)
        check_only=1
        ;;
    --help|-h)
        cat <<'HELP'
Usage: scripts/bootstrap [--check]

Install the pinned M0 tools and check the developer environment.
With --check, inspect the environment without installing or downloading tools.
HELP
        exit 0
        ;;
    *)
        printf 'Usage: scripts/bootstrap [--check]\n' >&2
        exit 64
        ;;
esac

failures=0

report() {
    local state="$1"
    local name="$2"
    local detail="$3"
    printf '%-7s %s: %s\n' "$state" "$name" "$detail"
}

check_xcodegen() {
    local executable="$repo_root/build/tools/xcodegen-$XCODEGEN_VERSION/bin/xcodegen"
    if [[ ! -x "$executable" ]]; then
        report FAIL "XcodeGen" "missing pinned $XCODEGEN_VERSION; run scripts/bootstrap"
        failures=$((failures + 1))
        return
    fi

    local found
    found="$("$executable" --version 2>/dev/null | awk '{ print $NF }' | tail -n 1 | tr -d '\r')"
    if [[ "$found" == "$XCODEGEN_VERSION" ]]; then
        report ok "XcodeGen" "$found"
    else
        report FAIL "XcodeGen" "expected $XCODEGEN_VERSION, found ${found:-unknown}"
        failures=$((failures + 1))
    fi
}

setup_python_tools() {
    local host_python="$repo_root/Images/tools/.venv/bin/python"
    local environment="$repo_root/Images/tools/.venv"
    local system_python
    system_python="$(command -v python3.12 2>/dev/null || true)"

    if [[ -z "$system_python" ]]; then
        report FAIL "Python image tooling" "install python@3.12 from scripts/Brewfile"
        failures=$((failures + 1))
        return
    fi

    if [[ "$check_only" -eq 1 ]]; then
        if [[ ! -x "$host_python" ]]; then
            report FAIL "Python image tooling" "missing Images/tools/.venv; run scripts/bootstrap"
            failures=$((failures + 1))
            return
        fi
        if ! "$host_python" -m pip --version >/dev/null 2>&1; then
            report FAIL "Python image tooling" "the virtual environment has no pip; run scripts/bootstrap"
            failures=$((failures + 1))
            return
        fi
        if ! "$host_python" -c \
            'import apkrun_image, cryptography, jsonschema, lz4, pytest, ruff'; then
            report FAIL "Python image tooling" "the image tools environment is incomplete; run scripts/bootstrap"
            failures=$((failures + 1))
            return
        fi
        report ok "Python image tooling" "$("$host_python" --version 2>&1)"
        return
    fi

    if [[ ! -x "$host_python" ]] || ! "$host_python" -m pip --version >/dev/null 2>&1; then
        if ! "$system_python" -m venv --clear "$environment"; then
            report FAIL "Python image tooling" "could not create Images/tools/.venv"
            failures=$((failures + 1))
            return
        fi
    fi
    if ! "$host_python" -m pip install -e "$repo_root/Images/tools[test]"; then
        report FAIL "Python image tooling" "dependency installation failed"
        failures=$((failures + 1))
        return
    fi
    report ok "Python image tooling" "$("$host_python" --version 2>&1)"
}

setup_homebrew_tools() {
    local brew_executable
    brew_executable="$(command -v brew 2>/dev/null || true)"
    if [[ -z "$brew_executable" ]]; then
        report FAIL "Homebrew packages" "install Homebrew, then run scripts/bootstrap"
        failures=$((failures + 1))
        return
    fi

    local brewfile="$repo_root/scripts/Brewfile"
    if [[ "$check_only" -eq 1 ]]; then
        if "$brew_executable" bundle check --no-upgrade --file "$brewfile" >/dev/null; then
            report ok "Homebrew packages" "Brewfile dependencies are installed"
        else
            report FAIL "Homebrew packages" "run brew bundle --file scripts/Brewfile"
            failures=$((failures + 1))
        fi
        return
    fi

    if "$brew_executable" bundle --no-upgrade --file "$brewfile"; then
        report ok "Homebrew packages" "Brewfile dependencies are installed"
    else
        report FAIL "Homebrew packages" "brew bundle failed for scripts/Brewfile"
        failures=$((failures + 1))
    fi
}

metal_tools_present() {
    local metal metallib
    metal="$(xcrun --find metal 2>/dev/null || true)"
    metallib="$(xcrun --find metallib 2>/dev/null || true)"
    [[ -n "$metal" && -x "$metal" && -n "$metallib" && -x "$metallib" ]]
}

check_metal_toolchain() {
    # Xcode ships the Metal compiler as a separate component. Hosted images may not
    # have it, so download it once when it is missing, then check again.
    if ! metal_tools_present; then
        xcodebuild -downloadComponent MetalToolchain >/dev/null 2>&1 || true
    fi
    local metal metallib
    metal="$(xcrun --find metal 2>/dev/null || true)"
    metallib="$(xcrun --find metallib 2>/dev/null || true)"
    if [[ -n "$metal" && -x "$metal" && -n "$metallib" && -x "$metallib" ]]; then
        report ok "Metal toolchain" "$("$metal" -v 2>&1 | head -n 1)"
    else
        report FAIL "Metal toolchain" "select Xcode 27 and install its Metal toolchain"
        failures=$((failures + 1))
    fi
}

install_xcodegen() {
    local tools_dir="$repo_root/build/tools/xcodegen-$XCODEGEN_VERSION"
    local executable="$tools_dir/bin/xcodegen"
    if [[ -x "$executable" ]] \
        && [[ "$("$executable" --version 2>/dev/null | awk '{ print $NF }' | tail -n 1)" == "$XCODEGEN_VERSION" ]]; then
        return
    fi

    local temporary_dir archive extracted binary actual_sha
    temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/apkrun-xcodegen.XXXXXX")"
    archive="$temporary_dir/xcodegen.zip"
    extracted="$temporary_dir/extracted"
    mkdir -p "$extracted"

    if ! curl --fail --location --retry 4 --retry-all-errors \
        --connect-timeout 20 --max-time 240 \
        "https://github.com/yonaskolb/XcodeGen/releases/download/$XCODEGEN_VERSION/xcodegen.zip" \
        --output "$archive"; then
        report FAIL "XcodeGen" "download failed"
        failures=$((failures + 1))
        rm -rf "$temporary_dir"
        return
    fi

    actual_sha="$(shasum -a 256 "$archive" | awk '{print $1}')"
    if [[ "$actual_sha" != "$XCODEGEN_SHA256" ]]; then
        report FAIL "XcodeGen" "SHA-256 mismatch for pinned archive"
        failures=$((failures + 1))
        rm -rf "$temporary_dir"
        return
    fi

    if ! unzip -q "$archive" -d "$extracted"; then
        report FAIL "XcodeGen" "archive extraction failed"
        failures=$((failures + 1))
        rm -rf "$temporary_dir"
        return
    fi

    binary="$(find "$extracted" -type f -name xcodegen -print -quit)"
    if [[ -z "$binary" ]]; then
        report FAIL "XcodeGen" "pinned archive does not contain the xcodegen executable"
        failures=$((failures + 1))
        rm -rf "$temporary_dir"
        return
    fi

    mkdir -p "$tools_dir/bin"
    install -m 0755 "$binary" "$executable"
    rm -rf "$temporary_dir"
}

# Downloads a pinned archive and checks its SHA-256 before anything is extracted.
fetch_pinned_archive() {
    local name="$1"
    local url="$2"
    local expected_sha="$3"
    local archive="$4"

    if ! curl --fail --location --retry 4 --retry-all-errors \
        --connect-timeout 20 --max-time 240 "$url" --output "$archive"; then
        report FAIL "$name" "download failed"
        failures=$((failures + 1))
        return 1
    fi

    if [[ "$(shasum -a 256 "$archive" | awk '{print $1}')" != "$expected_sha" ]]; then
        report FAIL "$name" "SHA-256 mismatch for pinned archive"
        failures=$((failures + 1))
        return 1
    fi
}

check_pinned_version() {
    local name="$1"
    local executable="$2"
    local expected="$3"
    local found

    if [[ ! -x "$executable" ]]; then
        report FAIL "$name" "missing pinned $expected; run scripts/bootstrap"
        failures=$((failures + 1))
        return
    fi

    found="$("$executable" --version 2>/dev/null | awk '{ print $NF }' | tail -n 1 | tr -d '\r')"
    if [[ "$found" == "$expected" ]]; then
        report ok "$name" "$found"
    else
        report FAIL "$name" "expected $expected, found ${found:-unknown}"
        failures=$((failures + 1))
    fi
}

install_protoc() {
    local tools_dir="$repo_root/build/tools/protoc-$PROTOC_VERSION"
    local executable="$tools_dir/bin/protoc"
    if [[ -x "$executable" ]] \
        && [[ "$("$executable" --version 2>/dev/null | awk '{ print $NF }' | tail -n 1)" == "$PROTOC_VERSION" ]]; then
        return
    fi

    local temporary_dir archive extracted
    temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/apkrun-protoc.XXXXXX")"
    archive="$temporary_dir/protoc.zip"
    extracted="$temporary_dir/extracted"
    mkdir -p "$extracted"

    if ! fetch_pinned_archive "protoc" \
        "https://github.com/protocolbuffers/protobuf/releases/download/v$PROTOC_VERSION/protoc-$PROTOC_VERSION-osx-aarch_64.zip" \
        "$PROTOC_SHA256" "$archive"; then
        rm -rf "$temporary_dir"
        return
    fi

    if ! unzip -q "$archive" -d "$extracted" || [[ ! -f "$extracted/bin/protoc" ]]; then
        report FAIL "protoc" "pinned archive does not contain bin/protoc"
        failures=$((failures + 1))
        rm -rf "$temporary_dir"
        return
    fi

    mkdir -p "$tools_dir/bin"
    install -m 0755 "$extracted/bin/protoc" "$executable"
    rm -rf "$tools_dir/include"
    cp -R "$extracted/include" "$tools_dir/include"
    rm -rf "$temporary_dir"
}

install_buf() {
    local tools_dir="$repo_root/build/tools/buf-$BUF_VERSION"
    local executable="$tools_dir/bin/buf"
    if [[ -x "$executable" ]] \
        && [[ "$("$executable" --version 2>/dev/null | tail -n 1)" == "$BUF_VERSION" ]]; then
        return
    fi

    local temporary_dir archive extracted
    temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/apkrun-buf.XXXXXX")"
    archive="$temporary_dir/buf.tar.gz"
    extracted="$temporary_dir/extracted"
    mkdir -p "$extracted"

    if ! fetch_pinned_archive "buf" \
        "https://github.com/bufbuild/buf/releases/download/v$BUF_VERSION/buf-Darwin-arm64.tar.gz" \
        "$BUF_SHA256" "$archive"; then
        rm -rf "$temporary_dir"
        return
    fi

    if ! tar -xzf "$archive" -C "$extracted" || [[ ! -f "$extracted/buf/bin/buf" ]]; then
        report FAIL "buf" "pinned archive does not contain buf/bin/buf"
        failures=$((failures + 1))
        rm -rf "$temporary_dir"
        return
    fi

    mkdir -p "$tools_dir/bin"
    install -m 0755 "$extracted/buf/bin/buf" "$executable"
    rm -rf "$temporary_dir"
}

# protoc-gen-swift is built from the swift-protobuf revision that Package.resolved
# pins, never from a branch. The stamp file records the revision that was built.
install_protoc_gen_swift() {
    local tools_dir="$repo_root/build/tools/protoc-gen-swift"
    local executable="$tools_dir/bin/protoc-gen-swift"
    local revision checkout bin_path

    revision="$(awk '/"identity" : "swift-protobuf"/ { found = 1 } found && /"revision"/ { gsub(/[",]/, "", $3); print $3; exit }' "$repo_root/Package.resolved")"
    if [[ -x "$executable" && "$(cat "$tools_dir/REVISION" 2>/dev/null || true)" == "$revision" ]]; then
        return
    fi

    if ! swift package --package-path "$repo_root" resolve; then
        report FAIL "protoc-gen-swift" "swift package resolve failed"
        failures=$((failures + 1))
        return
    fi

    checkout="$repo_root/.build/checkouts/swift-protobuf"
    if [[ "$(git -C "$checkout" rev-parse HEAD 2>/dev/null || true)" != "$revision" ]]; then
        report FAIL "protoc-gen-swift" "checkout is not at the revision that Package.resolved pins"
        failures=$((failures + 1))
        return
    fi

    if ! swift build -c release --package-path "$checkout" \
        --scratch-path "$tools_dir/build" --product protoc-gen-swift; then
        report FAIL "protoc-gen-swift" "build failed"
        failures=$((failures + 1))
        return
    fi

    bin_path="$(swift build -c release --package-path "$checkout" \
        --scratch-path "$tools_dir/build" --show-bin-path)"
    mkdir -p "$tools_dir/bin"
    install -m 0755 "$bin_path/protoc-gen-swift" "$executable"
    printf '%s\n' "$revision" > "$tools_dir/REVISION"
}

check_protoc_gen_swift() {
    local tools_dir="$repo_root/build/tools/protoc-gen-swift"
    local revision
    revision="$(awk '/"identity" : "swift-protobuf"/ { found = 1 } found && /"revision"/ { gsub(/[",]/, "", $3); print $3; exit }' "$repo_root/Package.resolved")"
    if [[ -x "$tools_dir/bin/protoc-gen-swift" && "$(cat "$tools_dir/REVISION" 2>/dev/null || true)" == "$revision" ]]; then
        report ok "protoc-gen-swift" "built from ${revision:0:12}"
    else
        report FAIL "protoc-gen-swift" "missing build of the pinned revision; run scripts/bootstrap"
        failures=$((failures + 1))
    fi
}

if [[ "$check_only" -eq 0 ]]; then
    install_xcodegen
    install_protoc
    install_buf
    install_protoc_gen_swift
fi

machine="$(uname -m 2>/dev/null || true)"
if [[ "$machine" != "arm64" ]]; then
    report FAIL "Apple Silicon" "expected arm64, found ${machine:-unknown}"
    failures=$((failures + 1))
else
    report ok "Apple Silicon" "$machine"
fi

macos_version="$(sw_vers -productVersion 2>/dev/null || true)"
macos_major="${macos_version%%.*}"
if [[ "$macos_major" =~ ^[0-9]+$ ]] && (( macos_major >= 27 )); then
    report ok "macOS" "$macos_version"
else
    report FAIL "macOS" "requires 27.0 or later; found ${macos_version:-unknown}"
    failures=$((failures + 1))
fi

expected_xcode="$(tr -d '[:space:]' < "$repo_root/.xcode-version")"
found_xcode="$(xcodebuild -version 2>/dev/null | awk '/^Xcode / { print $2; exit }' || true)"
if [[ "$found_xcode" == "$expected_xcode" ]]; then
    report ok "Xcode" "$found_xcode"
else
    report FAIL "Xcode" "expected $expected_xcode, found ${found_xcode:-unknown}"
    failures=$((failures + 1))
fi

swift_version="$(swift --version 2>/dev/null | sed -nE 's/.*Apple Swift version ([0-9]+\.[0-9]+).*/\1/p' | head -n 1)"
if [[ "$swift_version" =~ ^[0-9]+\.[0-9]+$ ]] \
    && awk -v version="$swift_version" 'BEGIN { split(version, v, "."); exit !((v[1] > 6) || (v[1] == 6 && v[2] >= 2)) }'; then
    report ok "Swift" "$swift_version (6.2 or later)"
else
    report FAIL "Swift" "requires 6.2 or later; found ${swift_version:-unknown}"
    failures=$((failures + 1))
fi

check_xcodegen
check_pinned_version "protoc" "$repo_root/build/tools/protoc-$PROTOC_VERSION/bin/protoc" "$PROTOC_VERSION"
check_pinned_version "buf" "$repo_root/build/tools/buf-$BUF_VERSION/bin/buf" "$BUF_VERSION"
check_protoc_gen_swift

nested_virtualization="$(xcrun swift -e 'import Virtualization; print(VZGenericPlatformConfiguration.isNestedVirtualizationSupported ? "supported" : "unsupported")' 2>/dev/null || true)"
case "$nested_virtualization" in
    supported)
        report ok "Nested virtualization" "supported"
        ;;
    unsupported)
        report warning "Nested virtualization" "not supported on this Mac; informational"
        ;;
    *)
        report warning "Nested virtualization" "could not be queried; informational"
        ;;
esac

available_kib="$(df -Pk "$repo_root" | awk 'END { print $4 }')"
if [[ "$available_kib" =~ ^[0-9]+$ ]] && (( available_kib >= 146484375 )); then
    report ok "Free disk" "at least 150 GB available"
else
    report warning "Free disk" "less than 150 GB is available; image and graphics builds need substantial space"
fi

check_metal_toolchain
setup_homebrew_tools
setup_python_tools
report skip "JDK and Android SDK" "added by #015"
report skip "Rust and cargo-ndk" "added by #034"
report skip "Android Build API key" "added by #008"

if (( failures > 0 )); then
    exit 1
fi
