    "APKRun couldn't change the menu bar item. Check Login Items in System Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APKRun couldn't change the menu bar item. Check Login Items in System Settings."
