on init
    setprop ro.apkrun.product 1

on property:ro.boot.apkrun.devmode=1
    setprop service.adb.listen_addrs vsock:5555
    start adbd

on property:ro.boot.apkrun.devmode=0
    setprop persist.sys.usb.config none
    setprop sys.usb.config none
    stop adbd

on property:persist.sys.usb.config=* && property:ro.boot.apkrun.devmode=0
    setprop persist.sys.usb.config none
    setprop sys.usb.config none
    stop adbd

on property:sys.usb.config=* && property:ro.boot.apkrun.devmode=0
    setprop sys.usb.config none
    stop adbd

service apkrun_vsockd /system_ext/bin/apkrun_vsockd
    class main
    user system
    group system
    capabilities
    restart_period 1
