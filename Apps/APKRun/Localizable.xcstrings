          "stringUnit": {
            "state": "translated",
            "value": "システム設定の「一般」→「ログイン項目」で APKRunMenuBar を許可してください。"
          }
        }
      }
    },
    "Allow “\\(prompt.displayName)” to open \\(prompt.packageID.rawValue) in APKRun?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow “\\(prompt.displayName)” to open \\(prompt.packageID.rawValue) in APKRun?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「\\(prompt.displayName)」が APKRun で \\(prompt.packageID.rawValue) を開くことを許可しますか？"
          }
        }
      }
    },
