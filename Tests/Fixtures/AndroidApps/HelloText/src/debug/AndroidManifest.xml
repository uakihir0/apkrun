<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only (IR-920). The release manifest has no such receiver. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".DebugCounterReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.apkrun.fixture.hellotext.debug.INCREMENT" />
                <action android:name="io.apkrun.fixture.hellotext.debug.READ" />
                <action android:name="io.apkrun.fixture.hellotext.debug.TOUCH_TRACE_START" />
                <action android:name="io.apkrun.fixture.hellotext.debug.TOUCH_TRACE_DRAIN" />
                <action android:name="io.apkrun.fixture.hellotext.debug.TEXT" />
                <action android:name="io.apkrun.fixture.hellotext.debug.DETAILS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
