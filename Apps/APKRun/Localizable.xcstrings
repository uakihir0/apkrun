    "Allow APKRun in System Settings > General > Login Items to show the menu bar item.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow APKRun in System Settings > General > Login Items to show the menu bar item."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目を表示するには、システム設定の「一般」→「ログイン項目」で APKRun を許可してください。"
          }
        }
      }
    },
    "Allow APKRun in System Settings > General > Login Items, then reopen it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow APKRun in System Settings > General > Login Items, then reopen it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定の「一般」→「ログイン項目」で APKRun を許可してから、開き直してください。"
          }
        }
      }
    },
    "Allow APKRunMenuBar in System Settings > General > Login Items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow APKRunMenuBar in System Settings > General > Login Items."
